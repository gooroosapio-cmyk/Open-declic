# Copier ce fichier en .env.local et renseigner les valeurs.
# Seules des valeurs PUBLIQUES sont utilisées par l'application :
# la clé publiable Supabase est faite pour le navigateur, les droits sont
# garantis par les règles RLS de la base. Aucune clé secrète n'est nécessaire.

# URL du projet Supabase (local : http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_...) — affichée par `npx supabase status` en local
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL publique de l'application (liens de confirmation d'e-mail)
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
